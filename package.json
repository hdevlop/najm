{
  "name": "najm-root",
  "description": "🚀 Smart DI toolkit, build elegant APIs with decorators, guards, and robust dependency injection. Zero-config, type-safe, and lightning fast.",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.2.10",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "benchmarks"
    ],
    "nohoist": []
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.0.11",
    "@isaacs/brace-expansion": "5.0.1",
    "axios": "1.18.1",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "diff": "4.0.4",
    "esbuild": "0.25.12",
    "express-rate-limit": "8.2.2",
    "fast-uri": "3.1.4",
    "file-type": "21.3.4",
    "find-my-way": "9.7.0",
    "form-data": "4.0.6",
    "ip-address": "10.2.0",
    "js-yaml": "3.15.0",
    "minimatch": "10.2.5",
    "music-metadata": "11.14.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.22",
    "protobufjs": "7.6.5",
    "qs": "6.15.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rollup": "4.62.2",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "vite": "7.3.6",
    "ws": "8.21.1",
    "zod": "4.4.3",
    "yaml": "2.9.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "najm-api": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "sqlite-vec": "^0.1.9",
    "tsup": "^8.5.1",
    "turbo": "^2.10.6",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^2.0.11",
    "bcrypt": "^6.0.0",
    "diject": "^0.1.8",
    "dotenv-pro": "^0.2.0",
    "forji": "^1.0.5",
    "hono": "^4.12.31",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mitt": "^3.0.1",
    "nodemailer": "^9.0.3",
    "pm-ninja": "^1.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "strip-json-comments": "^5.0.3",
    "supertest": "^7.2.2",
    "ts-mixer": "^6.0.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "vite-node": "^5.3.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "turbo run build",
    "build:auth": "turbo run build --filter=najm-auth",
    "build:cache": "turbo run build --filter=najm-cache",
    "build:cli": "turbo run build --filter=najm-cli",
    "build:cookies": "turbo run build --filter=najm-cookies",
    "build:najm": "turbo run build --filter=najm-api",
    "build:core": "turbo run build --filter=najm-core",
    "build:cors": "turbo run build --filter=najm-cors",
    "build:database": "turbo run build --filter=najm-database",
    "build:email": "turbo run build --filter=najm-email",
    "build:event": "turbo run build --filter=najm-event",
    "build:guard": "turbo run build --filter=najm-guard",
    "build:i18n": "turbo run build --filter=najm-i18n",
    "build:rate": "turbo run build --filter=najm-rate",
    "build:mcp": "turbo run build --filter=najm-mcp",
    "build:rag": "bun scripts/build-rag.ts",
    "check:studio-budget": "bun scripts/check-studio-budget.ts",
    "build:storage": "turbo run build --filter=najm-storage",
    "build:validation": "turbo run build --filter=najm-validation",
    "build:chatbot": "turbo run build --filter=najm-chatbot",
    "build:whatsapp": "turbo run build --filter=najm-whatsapp",
    "build:ui": "bun run --cwd packages/najm-kit build",
    "dev:theme-studio": "bun run --cwd apps/theme-studio dev",
    "theme-studio": "bun run --cwd apps/theme-studio dev",
    "theme-studio:preview": "bun run --cwd apps/theme-studio preview",
    "build:theme-studio": "bun run --cwd apps/theme-studio build",
    "build:playground": "bun run --cwd apps/playground build:next",
    "test": "bun run test:seq",
    "test:parallel": "turbo run test",
    "test:auth": "turbo run test --filter=najm-auth",
    "test:auth:next16": "bun run --cwd packages/najm-auth test:next16",
    "test:cache": "turbo run test --filter=najm-cache",
    "test:cookies": "turbo run test --filter=najm-cookies",
    "test:najm": "turbo run test --filter=najm-api",
    "test:core": "turbo run test --filter=najm-core",
    "test:cors": "turbo run test --filter=najm-cors",
    "test:database": "turbo run test --filter=najm-database",
    "test:email": "turbo run test --filter=najm-email",
    "test:event": "turbo run test --filter=najm-event",
    "test:guard": "turbo run test --filter=najm-guard",
    "test:i18n": "turbo run test --filter=najm-i18n",
    "test:rate": "turbo run test --filter=najm-rate",
    "test:mcp": "turbo run test --filter=najm-mcp",
    "test:rag": "bun --cwd packages/najm-rag test",
    "test:storage": "turbo run test --filter=najm-storage",
    "test:chatbot": "bun --cwd packages/najm-chatbot test",
    "test:validation": "turbo run test --filter=najm-validation",
    "test:whatsapp": "turbo run test --filter=najm-whatsapp",
    "test:ui": "bun run --cwd packages/najm-kit test",
    "lint:ui": "bun run --cwd packages/najm-kit lint",
    "typecheck:ui": "bun run --cwd packages/najm-kit typecheck:tests",
    "test:seq": "bun run scripts/test-sequential.ts",
    "test:node-runtime": "node scripts/node-runtime-smoke.mjs",
    "test:playground:e2e": "bun --cwd apps/playground test",
    "api:snapshot": "bun scripts/check-public-api.mjs --write",
    "api:check": "bun scripts/check-public-api.mjs",
    "bench": "bun benchmarks/http.bench.ts",
    "bench:hotpath": "bun benchmarks/hotpath.bench.ts",
    "bench:frameworks": "bun benchmarks/frameworks.bench.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "bun run api:check && changeset status --verbose",
    "publish:all": "bun scripts/publish-all.ts",
    "publish:all:dry": "bun scripts/publish-all.ts --dry-run",
    "publish:pkg": "bun scripts/publish-package.ts",
    "publish:pkg:dry": "bun scripts/publish-package.ts --dry-run",
    "pub:najm": "bun scripts/publish-package.ts najm-api",
    "pub:core": "bun scripts/publish-package.ts najm-core",
    "pub:guard": "bun scripts/publish-package.ts najm-guard",
    "pub:validation": "bun scripts/publish-package.ts najm-validation",
    "pub:cache": "bun scripts/publish-package.ts najm-cache",
    "pub:rate": "bun scripts/publish-package.ts najm-rate",
    "pub:mcp": "bun scripts/publish-package.ts najm-mcp",
    "pub:rag": "bun scripts/publish-package.ts najm-rag",
    "pub:cors": "bun scripts/publish-package.ts najm-cors",
    "pub:cookies": "bun scripts/publish-package.ts najm-cookies",
    "pub:i18n": "bun scripts/publish-package.ts najm-i18n",
    "pub:event": "bun scripts/publish-package.ts najm-event",
    "pub:database": "bun scripts/publish-package.ts najm-database",
    "pub:email": "bun scripts/publish-package.ts najm-email",
    "pub:auth": "bun scripts/publish-package.ts najm-auth",
    "pub:chatbot": "bun scripts/publish-package.ts najm-chatbot",
    "pub:whatsapp": "bun scripts/publish-package.ts najm-whatsapp",
    "pub:cli": "bun scripts/publish-package.ts najm-cli",
    "pub:storage": "bun scripts/publish-package.ts najm-storage",
    "pub:ui": "bun scripts/publish-package.ts najm-kit",
    "dev:ui": "bun run --cwd packages/najm-kit dev",
    "start": "bun --watch main.ts",
    "clean": "turbo run clean && rimraf dist",
    "web": "bun run --cwd apps/website dev",
    "web:start": "bun run --cwd apps/website start",
    "playground": "bun run --cwd apps/playground dev",
    "playground:start": "bun run --cwd apps/playground start",
    "playground:next": "bun run --cwd apps/playground dev:next",
    "playground:next:build": "bun run --cwd apps/playground build:next",
    "playground:next:start": "bun run --cwd apps/playground start:next",
    "playground:next:prod": "bun run playground:next:build && bun run playground:next:start",
    "playground:next:bg": "bun scripts/playground-next-background.ts start",
    "playground:next:stop": "bun scripts/playground-next-background.ts stop",
    "playground:next:status": "bun scripts/playground-next-background.ts status"
  },
  "author": "Hicham Jebara",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "api",
    "framework",
    "typescript",
    "decorators",
    "dependency-injection",
    "hono",
    "nodejs",
    "bun"
  ],
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdevlop/najm.git"
  },
  "bugs": {
    "url": "https://github.com/hdevlop/najm/issues"
  },
  "homepage": "https://github.com/hdevlop/najm#readme"
}
