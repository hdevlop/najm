{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "composite": true,
    "types": ["node", "bun"],
    "baseUrl": "../..",
    "paths": {
      "najm-auth": ["packages/najm-auth/src/index.ts"],
      "najm-auth/*": ["packages/najm-auth/src/*"],
      "najm-cache": ["packages/najm-cache/src/index.ts"],
      "najm-cache/*": ["packages/najm-cache/src/*"],
      "najm-core": ["packages/najm-core/src/index.ts"],
      "najm-core/*": ["packages/najm-core/src/*"],
      "najm-database": ["packages/najm-database/src/index.ts"],
      "najm-database/*": ["packages/najm-database/src/*"],
      "najm-event": ["packages/najm-event/src/index.ts"],
      "najm-event/*": ["packages/najm-event/src/*"],
      "najm-guard": ["packages/najm-guard/src/index.ts"],
      "najm-guard/*": ["packages/najm-guard/src/*"],
      "najm-mcp": ["packages/najm-mcp/src/index.ts"],
      "najm-mcp/*": ["packages/najm-mcp/src/*"],
      "najm-rag": ["packages/najm-rag/src/index.ts"],
      "najm-rag/*": ["packages/najm-rag/src/*"],
      "najm-validation": ["packages/najm-validation/src/index.ts"],
      "najm-validation/*": ["packages/najm-validation/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
