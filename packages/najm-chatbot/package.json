{
  "name": "najm-chatbot",
  "version": "2.0.1",
  "description": "Chatbot plugin for najm framework — AI settings, LLM provider factory, MCP tool adapter, chat agent, and React UI",
  "type": "module",
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.mjs",
      "default": "./dist/schema/sqlite.mjs"
    },
    "./pg": {
      "types": "./dist/schema/pg.d.ts",
      "import": "./dist/schema/pg.mjs",
      "default": "./dist/schema/pg.mjs"
    },
    "./mysql": {
      "types": "./dist/schema/mysql.d.ts",
      "import": "./dist/schema/mysql.mjs",
      "default": "./dist/schema/mysql.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "default": "./dist/testing/index.mjs"
    },
    "./rag": {
      "types": "./dist/rag.d.ts",
      "import": "./dist/rag.mjs",
      "default": "./dist/rag.mjs"
    },
    "./studio-assistant": {
      "types": "./dist/studio-assistant.d.ts",
      "import": "./dist/studio-assistant.mjs",
      "default": "./dist/studio-assistant.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "chatbot",
    "ai",
    "llm",
    "najm",
    "mcp",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "najm-core": "workspace:*",
    "najm-cache": "workspace:*",
    "najm-event": "workspace:*",
    "ai": "^4.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/react": "^1.2.12",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "najm-auth": "workspace:*",
    "najm-database": "workspace:*",
    "najm-guard": "workspace:*",
    "najm-mcp": "workspace:*",
    "najm-rag": "workspace:*",
    "najm-validation": "workspace:*",
    "rimraf": "^6.0.1",
    "sqlite-vec": "^0.1.9",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "najm-auth": "workspace:*",
    "najm-database": "workspace:*",
    "najm-guard": "workspace:*",
    "najm-mcp": "workspace:*",
    "najm-rag": "workspace:*",
    "najm-validation": "workspace:*",
    "react": ">=18",
    "reflect-metadata": "^0.2.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "najm-rag": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  }
}
