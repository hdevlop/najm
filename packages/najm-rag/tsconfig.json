{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "baseUrl": "../..",
    "paths": {
      "najm-auth": ["packages/najm-auth/src/index.ts"],
      "najm-auth/*": ["packages/najm-auth/src/*"],
      "najm-core": ["packages/najm-core/src/index.ts"],
      "najm-core/*": ["packages/najm-core/src/*"],
      "najm-database": ["packages/najm-database/src/index.ts"],
      "najm-database/*": ["packages/najm-database/src/*"],
      "najm-mcp": ["packages/najm-mcp/src/index.ts"],
      "najm-mcp/*": ["packages/najm-mcp/src/*"],
      "najm-storage": ["packages/najm-storage/src/index.ts"],
      "najm-storage/*": ["packages/najm-storage/src/*"],
      "najm-validation": ["packages/najm-validation/src/index.ts"],
      "najm-validation/*": ["packages/najm-validation/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
