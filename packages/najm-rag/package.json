{
  "name": "najm-rag",
  "version": "0.0.4",
  "description": "RAG engine for Najm framework — embeddings, vector search, and semantic tool routing",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.mjs",
      "default": "./dist/schema/sqlite.mjs"
    },
    "./pg": {
      "types": "./dist/schema/pg.d.ts",
      "import": "./dist/schema/pg.mjs",
      "default": "./dist/schema/pg.mjs"
    },
    "./mysql": {
      "types": "./dist/schema/mysql.d.ts",
      "import": "./dist/schema/mysql.mjs",
      "default": "./dist/schema/mysql.mjs"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.mjs",
      "default": "./dist/studio/index.mjs"
    },
    "./studio/styles.css": {
      "import": "./dist/studio/styles.css",
      "default": "./dist/studio/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:css": "node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "test": "bun test",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "najm-core": "workspace:*",
    "pdf-parse": "^1.1.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-router": "^1.170.8",
    "@uiw/react-codemirror": "^4.25.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "najm-ui": "workspace:*",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.5"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "hono": "^4.0.0",
    "najm-auth": "workspace:*",
    "najm-database": "workspace:*",
    "najm-guard": "workspace:*",
    "najm-mcp": "workspace:*",
    "najm-storage": "workspace:*",
    "najm-validation": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18",
    "reflect-metadata": "^0.2.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "najm-storage": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": ">=18",
    "@types/react-dom": ">=18",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "najm-auth": "workspace:*",
    "najm-database": "workspace:*",
    "najm-mcp": "workspace:*",
    "najm-storage": "workspace:*",
    "najm-validation": "workspace:*",
    "postcss": "^8.4.49",
    "postcss-prefix-selector": "^2.1.0",
    "rimraf": "^6.0.1",
    "sqlite-vec": "^0.1.9",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
