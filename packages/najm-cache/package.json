{
  "name": "najm-cache",
  "version": "2.2.0",
  "description": "Unified cache plugin for najm framework - Memory and Redis drivers with auto-fallback",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "cache",
    "redis",
    "memory",
    "najm",
    "ioredis",
    "key-value",
    "store"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "najm-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ioredis": "^5.4.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "ioredis": "^5.0.0"
  }
}
