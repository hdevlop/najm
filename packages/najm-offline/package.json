{
  "name": "najm-offline",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Read-only offline use for Najm applications: granted, account-bound downloads of recorded API responses, an offline shell, and its worker, build and test kit",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./pwa": {
      "types": "./dist/pwa.d.ts",
      "import": "./dist/pwa.js",
      "default": "./dist/pwa.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./shell/navigation": {
      "types": "./dist/shell/navigation.d.ts",
      "import": "./dist/shell/navigation.js",
      "default": "./dist/shell/navigation.js"
    },
    "./shell/link": {
      "types": "./dist/shell/link.d.ts",
      "import": "./dist/shell/link.js",
      "default": "./dist/shell/link.js"
    },
    "./shell/image": {
      "types": "./dist/shell/image.d.ts",
      "import": "./dist/shell/image.js",
      "default": "./dist/shell/image.js"
    },
    "./shell/auth": {
      "types": "./dist/shell/auth.d.ts",
      "import": "./dist/shell/auth.js",
      "default": "./dist/shell/auth.js"
    },
    "./shell/kit": {
      "types": "./dist/shell/kit.d.ts",
      "import": "./dist/shell/kit.js",
      "default": "./dist/shell/kit.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js",
      "default": "./dist/pg.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js",
      "default": "./dist/build.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bun run typecheck",
    "test": "bun test ./test",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "najm",
    "offline",
    "pwa",
    "service-worker",
    "indexeddb",
    "replica"
  ],
  "author": "Hicham Jebara",
  "peerDependencies": {
    "najm-database": "^2.3.3",
    "najm-auth": "^6.10.0",
    "najm-next": "^0.15.1",
    "najm-kit": "^3.7.0",
    "fast-idb": "0.3.1",
    "@tanstack/react-query": "^5",
    "react": ">=18.2.0 <20",
    "drizzle-orm": ">=0.36.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "najm-auth": {
      "optional": true
    },
    "najm-next": {
      "optional": true
    },
    "najm-kit": {
      "optional": true
    },
    "fast-idb": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "najm-database": "workspace:*",
    "najm-auth": "workspace:*",
    "najm-next": "workspace:*",
    "najm-kit": "workspace:*",
    "fast-idb": "0.3.1",
    "fake-indexeddb": "6.2.5",
    "@tanstack/react-query": "^5",
    "@types/react": "^19.2.14",
    "@types/node": "^25.0.2",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.11.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
