{
  "name": "najm-storage",
  "version": "2.1.1",
  "license": "MIT",
  "description": "File storage plugin for najm framework — local filesystem and database backends",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js",
      "default": "./dist/schema/sqlite.js"
    },
    "./pg": {
      "types": "./dist/schema/pg.d.ts",
      "import": "./dist/schema/pg.js",
      "default": "./dist/schema/pg.js"
    },
    "./mysql": {
      "types": "./dist/schema/mysql.d.ts",
      "import": "./dist/schema/mysql.js",
      "default": "./dist/schema/mysql.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.mjs",
      "default": "./dist/studio/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "default": "./dist/client/index.mjs"
    },
    "./client-db": {
      "types": "./dist/client-db/index.d.ts",
      "import": "./dist/client-db/index.mjs",
      "default": "./dist/client-db/index.mjs"
    },
    "./studio/styles.css": {
      "import": "./dist/studio/styles.css",
      "default": "./dist/studio/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:css": "node scripts/build-css.mjs",
    "test": "bun test --preload ./test/studio/setup.ts",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "najm-core": "workspace:*",
    "najm-event": "workspace:*",
    "najm-database": "workspace:*",
    "@tanstack/react-router": "^1.170.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "najm-kit": "workspace:*",
    "recharts": "^2.15.0",
    "sonner": "^2",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5.0",
    "drizzle-orm": ">=0.45.2",
    "hono": "^4.12.18",
    "najm-mcp": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18",
    "reflect-metadata": "^0.2.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "peerDependenciesMeta": {
    "najm-mcp": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "fake-indexeddb": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.11.1",
    "najm-mcp": "workspace:*",
    "postcss": "^8.5.22",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "zod": "^4.2.1"
  }
}
