{
  "name": "najm-storage",
  "version": "1.1.17",
  "description": "File storage plugin for najm framework — local filesystem and database backends",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js",
      "default": "./dist/schema/sqlite.js"
    },
    "./pg": {
      "types": "./dist/schema/pg.d.ts",
      "import": "./dist/schema/pg.js",
      "default": "./dist/schema/pg.js"
    },
    "./mysql": {
      "types": "./dist/schema/mysql.d.ts",
      "import": "./dist/schema/mysql.js",
      "default": "./dist/schema/mysql.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "najm-core": "workspace:*",
    "najm-event": "workspace:*",
    "najm-database": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "*",
    "hono": "^4.0.0",
    "najm-mcp": "workspace:*",
    "reflect-metadata": "^0.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "najm-mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "drizzle-orm": "^0.45.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1",
    "zod": "^4.2.1"
  }
}
