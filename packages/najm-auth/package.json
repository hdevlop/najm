{
  "name": "najm-auth",
  "version": "3.4.0",
  "description": "Authentication and authorization library for najm framework",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client/edge": {
      "types": "./dist/client/edge.d.ts",
      "import": "./dist/client/edge.js",
      "default": "./dist/client/edge.js"
    },
    "./client/react": {
      "types": "./dist/client/react/index.d.ts",
      "import": "./dist/client/react/index.js",
      "default": "./dist/client/react/index.js"
    },
    "./client/server": {
      "types": "./dist/client/server/index.d.ts",
      "import": "./dist/client/server/index.js",
      "default": "./dist/client/server/index.js"
    },
    "./client/server/react": {
      "types": "./dist/client/server/react.d.ts",
      "react-server": "./dist/client/server/react.js",
      "browser": "./dist/client/server/reactClientGuard.js",
      "import": "./dist/client/server/react.js",
      "default": "./dist/client/server/react.js"
    },
    "./identity/ma": {
      "types": "./dist/identity/ma.d.ts",
      "import": "./dist/identity/ma.js",
      "default": "./dist/identity/ma.js"
    },
    "./pg": {
      "types": "./dist/schema/pg.d.ts",
      "import": "./dist/schema/pg.js",
      "default": "./dist/schema/pg.js"
    },
    "./sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js",
      "default": "./dist/schema/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test && bun run test:rsc",
    "test:rsc": "bun test --conditions react-server test/react-server-auth.test.ts",
    "test:next16": "bun run build && bun integration/next16-proxy/run.ts",
    "test:watch": "bun test --watch",
    "start": "bun --watch src/main.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "authentication",
    "authorization",
    "jwt",
    "oauth",
    "session",
    "decorators",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.11.1",
    "next": "16.2.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "najm-cookies": "workspace:*",
    "najm-core": "workspace:*",
    "najm-database": "workspace:*",
    "najm-guard": "workspace:*",
    "najm-i18n": "workspace:*",
    "najm-cache": "workspace:*",
    "najm-email": "workspace:*",
    "najm-rate": "workspace:*",
    "najm-validation": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "jose": "^6.1.3",
    "lodash.isempty": "^4.4.0",
    "nanoid": "^5.1.6",
    "reflect-metadata": "^0.2.2",
    "timestring": "^7.0.0",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "react": ">=18",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
