{
  "name": "najm-core",
  "version": "1.2.8",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "start": "bun --watch src/main.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "diject": "^0.1.5",
    "hono": "^4.7.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  }
}
