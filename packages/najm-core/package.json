  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.9",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  }
