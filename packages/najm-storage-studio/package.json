{
  "name": "najm-storage-studio",
  "version": "0.0.1",
  "description": "Embeddable Storage Studio React component library for Najm framework",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": {
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:css": "node scripts/build-css.mjs",
    "test": "bun test --preload ./test/setup.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "najm-ui": "workspace:*",
    "recharts": "^2.15.0",
    "sonner": "^2",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^17.6.3",
    "postcss": "^8.5.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
