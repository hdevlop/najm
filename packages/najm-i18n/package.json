{
  "name": "najm-i18n",
  "version": "2.0.3",
  "license": "MIT",
  "description": "I18n .",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "start": "bun --watch src/main.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.11.1",
    "najm-core": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "najm-core": "workspace:*",
    "react": ">=18",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
