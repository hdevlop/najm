{
  "name": "najm-next",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Strict, versioned Next.js configuration for Najm applications — monorepo root discovery, build isolation, service-worker headers, and dev-origin policy with no per-app options",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./configurable": {
      "types": "./dist/configurable.d.ts",
      "import": "./dist/configurable.js",
      "default": "./dist/configurable.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bun run typecheck",
    "test": "bun test ./test",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "najm",
    "next",
    "nextjs",
    "config",
    "monorepo",
    "preset"
  ],
  "author": "Hicham Jebara",
  "peerDependencies": {
    "next": ">=15.3.0 <17"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "next": "16.2.11",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
