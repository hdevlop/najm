{
  "name": "najm-next",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "description": "Strict, versioned Next.js configuration for Najm applications — monorepo root discovery, build isolation, service-worker headers, and dev-origin policy with no per-app options",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./configurable": {
      "types": "./dist/configurable.d.ts",
      "import": "./dist/configurable.js",
      "default": "./dist/configurable.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./app/server": {
      "types": "./dist/app/server.d.ts",
      "import": "./dist/app/server.js",
      "default": "./dist/app/server.js"
    },
    "./app/react": {
      "types": "./dist/app/react.d.ts",
      "import": "./dist/app/react.js",
      "default": "./dist/app/react.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js",
      "default": "./dist/security.js"
    },
    "./security/reports": {
      "types": "./dist/security/reports.d.ts",
      "import": "./dist/security/reports.js",
      "default": "./dist/security/reports.js"
    },
    "./instrumentation/client": {
      "types": "./dist/instrumentation/client.d.ts",
      "import": "./dist/instrumentation/client.js",
      "default": "./dist/instrumentation/client.js"
    },
    "./location/server": {
      "types": "./dist/location/server.d.ts",
      "import": "./dist/location/server.js",
      "default": "./dist/location/server.js"
    },
    "./pwa": {
      "types": "./dist/pwa.d.ts",
      "import": "./dist/pwa.js",
      "default": "./dist/pwa.js"
    },
    "./pwa/react": {
      "types": "./dist/pwaReact.d.ts",
      "import": "./dist/pwaReact.js",
      "default": "./dist/pwaReact.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bun run typecheck",
    "test": "bun test ./test && bun run test:rsc",
    "test:rsc": "cd test/rsc && bun test --conditions react-server",
    "test:watch": "bun test --watch",
    "test:next16": "bun run build && bun integration/csp-proxy/run.ts && bun integration/app-server/run.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "najm",
    "next",
    "nextjs",
    "config",
    "monorepo",
    "preset"
  ],
  "author": "Hicham Jebara",
  "peerDependencies": {
    "next": ">=15.3.0 <17",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/node": "^25.0.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
