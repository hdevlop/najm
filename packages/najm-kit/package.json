{
  "name": "najm-kit",
  "version": "2.1.46",
  "license": "MIT",
  "type": "module",
  "description": "Reusable React UI component package for Najm framework",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./theme.css": {
      "types": "./dist/theme.css.d.ts",
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.mjs",
      "default": "./dist/adapters/next.mjs"
    },
    "./package.json": "./package.json",
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.mjs",
      "default": "./dist/json.mjs"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "bun run typecheck && bun run typecheck:tests",
    "dev": "vite",
    "dev:preview": "vite",
    "preview": "vite preview",
    "build:preview": "vite build",
    "test": "bun test",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": "^7",
    "@hookform/resolvers": "^5",
    "zod": ">=4",
    "@uiw/react-codemirror": "^4.25.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@lezer/highlight": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@uiw/react-codemirror": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@codemirror/theme-one-dark": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1",
    "@radix-ui/react-checkbox": "^1",
    "@radix-ui/react-collapsible": "^1",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-label": "^2",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-progress": "^1",
    "@radix-ui/react-radio-group": "^1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-switch": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-toggle": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@tanstack/react-table": "^8",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cmdk": "^1",
    "culori": "^4.0.2",
    "date-fns": "^4",
    "lucide-react": "^0.474",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react-colorful": "^5.7.0",
    "react-day-picker": "^9",
    "react-file-icon": "^1.6.0",
    "react-international-phone": "^4.8.0",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "tw-animate-css": "^1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.42.0",
    "@hookform/resolvers": "^5",
    "@lezer/highlight": "^1.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-file-icon": "^1.0.5",
    "@uiw/react-codemirror": "^4.25.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.22",
    "react-hook-form": "^7",
    "rimraf": "^6",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
