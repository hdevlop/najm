{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["dist", "node_modules", "playground"]
}
