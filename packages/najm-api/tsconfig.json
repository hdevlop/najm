{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",

    "composite": true,
    "baseUrl": "../..",
    "paths": {
      "najm-auth": ["packages/najm-auth/src/index.ts"],
      "najm-auth/*": ["packages/najm-auth/src/*"],
      "najm-cache": ["packages/najm-cache/src/index.ts"],
      "najm-cache/*": ["packages/najm-cache/src/*"],
      "najm-cookies": ["packages/najm-cookies/src/index.ts"],
      "najm-cookies/*": ["packages/najm-cookies/src/*"],
      "najm-core": ["packages/najm-core/src/index.ts"],
      "najm-core/*": ["packages/najm-core/src/*"],
      "najm-cors": ["packages/najm-cors/src/index.ts"],
      "najm-cors/*": ["packages/najm-cors/src/*"],
      "najm-database": ["packages/najm-database/src/index.ts"],
      "najm-database/*": ["packages/najm-database/src/*"],
      "najm-email": ["packages/najm-email/src/index.ts"],
      "najm-email/*": ["packages/najm-email/src/*"],
      "najm-event": ["packages/najm-event/src/index.ts"],
      "najm-event/*": ["packages/najm-event/src/*"],
      "najm-guard": ["packages/najm-guard/src/index.ts"],
      "najm-guard/*": ["packages/najm-guard/src/*"],
      "najm-i18n": ["packages/najm-i18n/src/index.ts"],
      "najm-i18n/*": ["packages/najm-i18n/src/*"],
      "najm-mcp": ["packages/najm-mcp/src/index.ts"],
      "najm-mcp/*": ["packages/najm-mcp/src/*"],
      "najm-rate": ["packages/najm-rate/src/index.ts"],
      "najm-rate/*": ["packages/najm-rate/src/*"],
      "najm-storage": ["packages/najm-storage/src/index.ts"],
      "najm-storage/*": ["packages/najm-storage/src/*"],
      "najm-validation": ["packages/najm-validation/src/index.ts"],
      "najm-validation/*": ["packages/najm-validation/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
