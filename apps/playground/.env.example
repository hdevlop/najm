# Najm Playground — local development secrets
#
# Copy this file to `apps/playground/.env` and replace every placeholder with
# real, locally generated values. Do NOT commit the populated `.env`.
#
# The defaults below are deliberately unsafe placeholders — a developer must
# generate new secrets per clone and per environment. Production deployments
# must override every secret with a managed value.

PORT=3000

# Path to the SQLite file used by the playground. The default sits next to the
# package; acceptance tests should use a path under `.runtime/` so the
# developer's local state is preserved.
DATABASE_URL=./playground.db

# The URL the OAuth callback targets, used for absolute redirects.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Required secrets
# ---------------------------------------------------------------------------

# 32+ random bytes, base64 or hex encoded. Used by `najm-auth` to sign access
# tokens.
JWT_ACCESS_SECRET=replace-with-secure-random-string

# 32+ random bytes, base64 or hex encoded. Used by `najm-auth` to sign refresh
# tokens.
JWT_REFRESH_SECRET=replace-with-secure-random-string

# 32 raw bytes, base64 or hex encoded. Used by `najm-auth` for at-rest
# encryption of stored secrets.
NAJM_ENCRYPTION_KEY=replace-with-a-base64-or-hex-encoded-32-byte-key

# Access-token lifetime. Defaults to 15m in `najm-auth` if absent.
JWT_ACCESS_EXPIRES_IN=15m

# Refresh-token lifetime. Defaults to 7d in `najm-auth` if absent.
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Cookie + transport
# ---------------------------------------------------------------------------

# Set COOKIE_SECURE=false for local HTTP production testing. LAN device
# testing and most acceptance runs use plain HTTP, and a Secure cookie set on
# HTTP is rejected by every browser. Leave unset (or `true`) for HTTPS.
# COOKIE_SECURE=false

# CORS origin for the Next frontend. The playground reflects any localhost
# origin by default; set this when a remote Next frontend must connect.
# CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Where the playground sends transactional mail. `console` is useful for local
# auth/password-reset flows.
EMAIL_PROVIDER=console

# ---------------------------------------------------------------------------
# Optional Google sign-in (enables automatically when both are present)
# ---------------------------------------------------------------------------
# Create a Web application OAuth client in Google Cloud and register
# http://localhost:3000/api/auth/oauth/google/callback exactly as an
# authorized redirect URI.
# GOOGLE_CLIENT_ID=<google-web-client-id>
# GOOGLE_CLIENT_SECRET=<google-web-client-secret>

# Only needed when the public API callback differs from
# FRONTEND_URL/api/auth/oauth/google/callback.
# GOOGLE_CALLBACK_URL=https://app.example.com/api/auth/oauth/google/callback
