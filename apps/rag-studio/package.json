{
  "name": "rag-studio-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Standalone RAG Studio — a full SPA (static export) to inspect/tune the RAG engine of any running najm app. Buildable to static files and wrappable as a desktop app.",
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build",
    "preview": "npx serve out -l 4100",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-router": "^1.170.8",
    "@uiw/react-codemirror": "^4.25.9",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "najm-chatbot": "workspace:*",
    "najm-kit": "workspace:*",
    "najm-rag": "workspace:*",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
